# ===== ИИ =====
# Провайдер: openai | gemini | anthropic | ollama | mock (mock — эвристика без ключа)
LLM_PROVIDER=mock
# Модель можно не указывать — будет gpt-5-mini / gemini-2.5-flash / claude-haiku-5-5
LLM_MODEL=

# Вариант 1 — OpenAI: LLM_PROVIDER=openai и ключ с https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Вариант 2 — Google Gemini: LLM_PROVIDER=gemini и ключ с https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Вариант 3 — Claude
ANTHROPIC_API_KEY=

# Эмбеддинги для поиска по резюме: hash (локально) | openai | ollama
# При смене пересоздайте базу (удалите backend/app.db или docker compose down -v)
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
EMBEDDING_DIM=384

# ===== Доступ =====
# Секрет для подписи токенов входа. Для production — длинная случайная строка
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Код, без которого нельзя зарегистрировать HR-аккаунт. Пусто — регистрация HR закрыта
HR_INVITE_CODE=koz-hr-2026
# Сервисный ключ для скриптов и MCP-сервера (заголовок X-API-Key, права HR)
API_KEY=dev-key

# ===== Данные кандидатов =====
# Скрывать телефоны, email и ИИН перед отправкой резюме в модель
MASK_PII=true
MAX_UPLOAD_MB=5

# ===== Интеграции =====
# true — запросы в CRM/1С только пишутся в журнал и никуда не уходят
INTEGRATIONS_DRY_RUN=true
BITRIX24_WEBHOOK_URL=
ONEC_BASE_URL=
ONEC_USER=
ONEC_PASSWORD=
