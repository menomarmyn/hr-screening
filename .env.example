# Ключ доступа к API (заголовок X-API-Key). Смените в production.
API_KEY=dev-key

# LLM-провайдер по умолчанию: mock | anthropic | openai | gemini | ollama
# mock работает без ключей (эвристика) — удобно для первого запуска
LLM_PROVIDER=mock
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Эмбеддинги: hash (локально, без вызовов) | openai | ollama
# При смене провайдера/размерности пересоздайте БД: docker compose down -v
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
EMBEDDING_DIM=384

# Маскировать телефоны, email, ИИН перед отправкой в LLM
MASK_PII=true

# Интеграции. true — запросы только пишутся в журнал, во внешние системы не уходят
INTEGRATIONS_DRY_RUN=true
BITRIX24_WEBHOOK_URL=
ONEC_BASE_URL=
ONEC_USER=
ONEC_PASSWORD=
